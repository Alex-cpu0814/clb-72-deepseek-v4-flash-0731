#!/bin/bash
set -uxo pipefail
cd /testbed
git config --global --add safe.directory /testbed
git status
git show --no-patch --oneline HEAD
git -c core.fileMode=false diff @BASE_COMMIT@
git checkout @BASE_COMMIT@ -- @TRACKED_TEST_FILES@ || exit 2
git apply -v - <<'EOF_114329324912' || exit 2
@TEST_PATCH@
EOF_114329324912
@OPTIONAL_PRE_TEST_BUILD@
: '>>>>> Start Test Output'
(@TEST_COMMAND@) | cat
: '>>>>> End Test Output'
git checkout @BASE_COMMIT@ -- @TRACKED_TEST_FILES@
rm -f -- @ADDED_TEST_FILES@

# 使用说明：复制为任务的 eval.sh，填写占位符后可删除这些注释。
# @BASE_COMMIT@：填写 task.yaml 里的完整 base_commit。
# @TRACKED_TEST_FILES@：只填 Base 提交中已存在、需要恢复的测试文件。
#   如果没有这类文件，删除开头和结尾的 checkout 行。
# @ADDED_TEST_FILES@：只填 test.patch 新增的文件，逐个列出，不用通配符。
#   这些文件在测试结束后清理。如果没有新增文件，删除结尾的 rm 行。
# @TEST_PATCH@：原样粘贴 test.patch，保留补丁的前导空格和上下两行分隔符。
# @OPTIONAL_PRE_TEST_BUILD@：仅在测试入口要求先构建当前源码时填写，例如
#   python setup.py build_ext --inplace --force || exit 2
#   填写完整构建步骤并在失败时退出。如果测试入口会构建或任务无需构建，删除占位行。
#   构建和测试所需的工具与依赖由 Dockerfile 准备。
# @TEST_COMMAND@：填写运行 tests.json 中指定用例的命令。该命令也可以同时构建和测试，
#   例如 Maven 的 mvnd test。外层括号和管道已提供。
#   Maven 使用 parse_log_maven 时，每条 Maven 命令只指定一个 -Dtest=类名#方法名，
#   tests.json 使用相同标识，并保留脚本开头的 -x。允许遇到首个失败就停止时可用 &&。
#   若失败后仍需运行其他用例，要保留各次执行的失败状态，不能只返回最后一个命令的状态。
#   同步核对 task.yaml 的 log_parser 与 tests.json 中的测试标识。
# 保留测试输出标记。SWE-bench 会在结束标记处记录测试命令的退出码。
# 用实际评估镜像验证 Base 和 Gold：Base 应未解决，Gold 应解决，并核对用例结果。
