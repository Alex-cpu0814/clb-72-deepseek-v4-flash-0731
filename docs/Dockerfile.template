FROM @BASE_IMAGE@

# 1. Install common system tools, then prepare the task's language environment.
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

@APT_SETUP@
RUN apt update && apt install -y \
    @SYSTEM_PACKAGES@ \
    && rm -rf /var/lib/apt/lists/*

@ENVIRONMENT_SETUP@

# 2. Clone the repository, reset to the task base, and prune later history.
ARG REPO_URL=@REPO_URL@
ARG BASE_COMMIT=@BASE@
ARG INSTANCE_ID=@INSTANCE@

RUN <<'EOF_b1406053c7c0'
#!/bin/bash
set -euo pipefail

git --version
git clone -o origin @CLONE_BRANCH@--single-branch "$REPO_URL" /testbed

cd /testbed
git reset --hard "$BASE_COMMIT"
@BEFORE_REMOTE_REMOVE@
git remote remove origin

base_epoch=$(git show -s --format=%ct "$BASE_COMMIT")
for tag in $(git tag -l); do
    if tag_epoch=$(git log -1 --format=%ct "refs/tags/$tag" -- 2>/dev/null) \
        && [[ -n "$tag_epoch" && "$tag_epoch" -gt "$base_epoch" ]]; then
        git tag -d "$tag"
    fi
done

current_branch=$(git symbolic-ref HEAD)
for branch in $(git for-each-ref --format='%(refname)' refs/heads); do
    if [[ "$branch" != "$current_branch" ]]; then
        git branch -D "${branch#refs/heads/}"
    fi
done

git reflog expire --expire=now --all
git gc --prune=now --aggressive
newer_commits=$(git rev-list --count --all --since="@$((base_epoch + 1))")
test "$newer_commits" -eq 0
git config core.autocrlf false
test "$(git rev-parse HEAD)" = "$BASE_COMMIT"
EOF_b1406053c7c0

# 3. Install repository-specific dependencies or precompile the base source.
RUN <<'CLB_PROJECT'
#!/bin/bash
set -euo pipefail

cd /testbed
@PROJECT_SETUP@

# 4. Check the source state after setup and cleanup.
test "$(git rev-parse HEAD)" = "$BASE_COMMIT"
git diff --exit-code "$BASE_COMMIT" --
worktree_status=$(git status --porcelain)
test -z "$worktree_status"
CLB_PROJECT

WORKDIR /testbed
CMD ["/bin/bash"]
@RUNTIME_SETTINGS@
