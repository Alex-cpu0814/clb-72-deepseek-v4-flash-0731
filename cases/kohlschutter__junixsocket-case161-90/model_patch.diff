diff --git a/junixsocket-native/src/main/c/receive.c b/junixsocket-native/src/main/c/receive.c
index 0077dc2..648f362 100644
--- a/junixsocket-native/src/main/c/receive.c
+++ b/junixsocket-native/src/main/c/receive.c
@@ -202,6 +202,17 @@ JNIEXPORT jint JNICALL Java_org_newsclub_net_unix_NativeUnixSocket_read(
 #if defined(junixsocket_use_poll_for_read)
     int ret = pollWithTimeout(env, fd, handle, 0);
     if(ret < 1) {
+        if(ret == 0) {
+            int flags = fcntl(handle, F_GETFL);
+            if (flags != -1 && (flags & O_NONBLOCK)) {
+                // no data on non-blocking socket
+                return -1;
+            } else {
+                // timeout on blocking socket
+                _throwException(env, kExceptionSocketTimeoutException, "timeout");
+                return -1;
+            }
+        }
         return -1;
     }
 #endif
