+static int junixsocket_stat(const char *path, struct stat *buf) {
+#if defined(__linux__) && defined(__GLIBC__) && !defined(__CROSSCLANG_NODEPS__)
+    // Workaround for https://github.com/kohlschutter/junixsocket/issues/69
+    // The "stat" symbol is not available as a dynamic symbol on older glibc
+    // versions; use the underlying "__xstat" implementation instead, which is
+    // exported by all glibc versions.
+    // The "nodeps" variant must not reference glibc-internal symbols such as
+    // "__xstat" (it is built without linking against glibc so it can run on
+    // alternative libc implementations such as musl).
+    return __xstat(_STAT_VER, path, buf);
+#else
+    return stat(path, buf);
+#endif
+}
