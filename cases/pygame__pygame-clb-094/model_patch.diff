     return result;
 }
 
+static int
+surface_fill_clip (SDL_Surface *surface, SDL_Rect *rect)
+{
+    int x = rect->x;
+    int y = rect->y;
+    int width = rect->w;
+    int height = rect->h;
+    int max_x, max_y;
+
+    if (x < 0)
+    {
+        width += x;
+        x = 0;
+    }
+
+    if (y < 0)
+    {
+        height += y;
+        y = 0;
+    }
+
+    max_x = surface->w;
+    max_y = surface->h;
+
+    if (x + width > max_x)
+        width = max_x - x;
+
+    if (y + height > max_y)
+        height = max_y - y;
+
+    if (width <= 0 || height <= 0)
+        return 0;
+
+    rect->x = x;
+    rect->y = y;
+    rect->w = width;
+    rect->h = height;
+    return 1;
+}
 
 int
 surface_fill_blend (SDL_Surface *surface, SDL_Rect *rect, Uint32 color,
@@ -800,6 +839,15 @@ surface_fill_blend (SDL_Surface *surface, SDL_Rect *rect, Uint32 color,
 {
     int result = -1;
