+/* Class RasterSourcePattern ------------------------------------------------- */
+
+typedef struct {
+    PyObject *callback;
+} PycairoRasterSourceCallback;
+
+typedef struct {
+    PycairoRasterSourceCallback acquire;
+    PycairoRasterSourceCallback release;
+    PycairoRasterSourceCallback snapshot;
+    PycairoRasterSourceCallback copy;
+    PycairoRasterSourceCallback finish;
+    cairo_content_t content;
+    cairo_pattern_t *pattern;
+} PycairoRasterSource;
+
+static const cairo_user_data_key_t PycairoRasterSourcePattern_key;
+
+static PycairoRasterSource *
+raster_source_pattern_get_data (PycairoRasterSourcePattern *o)
+{
+  PycairoRasterSource *priv = cairo_pattern_get_user_data (
+      o->pattern, &PycairoRasterSourcePattern_key);
+
+  if (priv == NULL) {
+    PyErr_SetString (PyExc_RuntimeError,
+                     "no private raster source data available");
+    return NULL;
+  }
+
+  return priv;
+}
+
+static void
+raster_source_pattern_clear_callback (PycairoRasterSourceCallback *callback)
+{
+  Py_CLEAR(callback->callback);
+}
+
+static PyObject *raster_source_pattern_borrow (cairo_pattern_t *pattern);
+static void raster_source_pattern_unborrow (PyObject *o);
+
+static void
+raster_source_pattern_destroy_func (void *data)
+{
+  PycairoRasterSource *priv = data;
+  PyGILState_STATE gstate;
+  PyObject *py_pattern = NULL, *result;
+
+  if (priv == NULL)
+    return;
+
+  /* This is called while the cairo pattern is being destroyed, so we still
+   * have a valid (but borrowed) pattern and can invoke the Python finish
+   * callback here. cairo calls the user_data destroy function before the
+   * raster source finish callback, so we also take care of the finish
+   * callback here and do not register a C finish function.
+   */
+  gstate = PyGILState_Ensure ();
+
+  if (priv->finish.callback != NULL) {
+    py_pattern = raster_source_pattern_borrow (priv->pattern);
+    if (py_pattern != NULL) {
+      result = PyObject_CallFunctionObjArgs (priv->finish.callback,
+                                             py_pattern, NULL);
+      Py_XDECREF (result);
+      raster_source_pattern_unborrow (py_pattern);
+    }
+  }
+
+  raster_source_pattern_clear_callback (&priv->acquire);
+  raster_source_pattern_clear_callback (&priv->release);
+  raster_source_pattern_clear_callback (&priv->snapshot);
+  raster_source_pattern_clear_callback (&priv->copy);
+  raster_source_pattern_clear_callback (&priv->finish);
+  PyMem_Free (priv);
+
+  PyGILState_Release (gstate);
+}
+
+/* Create a temporary Pattern wrapper around a pattern we do not own a
+ * reference to. This is used for the callbacks, which are invoked by cairo
+ * while the passed pattern is only borrowed (e.g. an internal shallow copy),
+ * so we must not take an additional reference there.
+ */
+static PyObject *
+raster_source_pattern_borrow (cairo_pattern_t *pattern)
+{
+  PyObject *o = PycairoPattern_Type.tp_alloc (&PycairoRasterSourcePattern_Type,
+                                              0);
+  if (o == NULL)
+    return NULL;
+
+  ((PycairoPattern *)o)->pattern = pattern;
+  ((PycairoPattern *)o)->base = NULL;
+  return o;
+}
+
+/* Drop a borrowed Pattern wrapper without destroying the underlying pattern.
+ */
+static void
+raster_source_pattern_unborrow (PyObject *o)
+{
+  if (o != NULL)
+    ((PycairoPattern *)o)->pattern = NULL;
+  Py_XDECREF (o);
+}
+
+static cairo_surface_t *
+raster_source_pattern_acquire (cairo_pattern_t *pattern,
+                               void *callback_data,
+                               cairo_surface_t *target,
+                               const cairo_rectangle_int_t *extents)
+{
+  PycairoRasterSource *priv = callback_data;
+  PyObject *py_pattern = NULL, *py_target = NULL, *py_extents = NULL;
+  PyObject *result;
+  cairo_surface_t *surface = NULL;
+
+  PyGILState_STATE gstate;
+
+  if (priv == NULL || priv->acquire.callback == NULL)
+    return NULL;
+
+  gstate = PyGILState_Ensure ();
+
+  py_pattern = raster_source_pattern_borrow (pattern);
+  if (py_pattern == NULL)
+    goto done;
+
+  py_target = PycairoSurface_FromSurface (cairo_surface_reference (target),
+                                          NULL);
+  if (py_target == NULL)
+    goto done;
+
+  py_extents = PycairoRectangleInt_FromRectangleInt (extents);
+  if (py_extents == NULL)
+    goto done;
+
+  result = PyObject_CallFunctionObjArgs (priv->acquire.callback,
+                                         py_pattern, py_target, py_extents,
+                                         NULL);
+  if (result == NULL)
+    goto done;
+
+  if (!PyObject_TypeCheck (result, &PycairoSurface_Type)) {
+    PyErr_SetString (PyExc_TypeError,
+                     "acquire callback should return a cairo.Surface");
+    Py_DECREF (result);
+    goto done;
+  }
+
+  surface = ((PycairoSurface *)result)->surface;
+  cairo_surface_reference (surface);
+  Py_DECREF (result);
+
+done:
+  raster_source_pattern_unborrow (py_pattern);
+  Py_XDECREF (py_target);
+  Py_XDECREF (py_extents);
+  PyGILState_Release (gstate);
+  return surface;
+}
+
+static void
+raster_source_pattern_release (cairo_pattern_t *pattern,
+                               void *callback_data,
+                               cairo_surface_t *surface)
+{
+  PycairoRasterSource *priv = callback_data;
+  PyObject *py_pattern = NULL, *py_surface = NULL, *result;
+
+  PyGILState_STATE gstate;
+
+  if (priv == NULL || priv->release.callback == NULL)
+    return;
+
+  gstate = PyGILState_Ensure ();
+
+  py_pattern = raster_source_pattern_borrow (pattern);
+  if (py_pattern == NULL)
+    goto done;
+
+  py_surface = PycairoSurface_FromSurface (cairo_surface_reference (surface),
+                                           NULL);
+  if (py_surface == NULL)
+    goto done;
+
+  result = PyObject_CallFunctionObjArgs (priv->release.callback,
+                                         py_pattern, py_surface, NULL);
+  Py_XDECREF (result);
+
+done:
+  raster_source_pattern_unborrow (py_pattern);
+  Py_XDECREF (py_surface);
+  PyGILState_Release (gstate);
+}
+
+static cairo_status_t
+raster_source_pattern_snapshot (cairo_pattern_t *pattern,
+                                void *callback_data)
+{
+  PycairoRasterSource *priv = callback_data;
+  PyObject *py_pattern = NULL, *result = NULL;
+  cairo_status_t status = CAIRO_STATUS_SUCCESS;
+
+  PyGILState_STATE gstate;
+
+  if (priv == NULL || priv->snapshot.callback == NULL)
+    return CAIRO_STATUS_SUCCESS;
+
+  gstate = PyGILState_Ensure ();
+
+  py_pattern = raster_source_pattern_borrow (pattern);
+  if (py_pattern == NULL)
+    goto done;
+
+  result = PyObject_CallFunctionObjArgs (priv->snapshot.callback,
+                                         py_pattern, NULL);
+  if (result == NULL)
+    goto done;
+
+  status = PYCAIRO_PyLong_AsLong (result);
+
+done:
+  Py_XDECREF (result);
+  raster_source_pattern_unborrow (py_pattern);
+  PyGILState_Release (gstate);
+  return status;
+}
+
+static cairo_status_t
+raster_source_pattern_copy (cairo_pattern_t *pattern,
+                            void *callback_data,
+                            const cairo_pattern_t *other)
+{
+  PycairoRasterSource *priv = callback_data;
+  PyObject *py_pattern = NULL, *py_other = NULL, *result = NULL;
+  cairo_status_t status = CAIRO_STATUS_SUCCESS;
+
+  PyGILState_STATE gstate;
+
+  if (priv == NULL || priv->copy.callback == NULL)
+    return CAIRO_STATUS_SUCCESS;
+
+  gstate = PyGILState_Ensure ();
+
+  py_pattern = raster_source_pattern_borrow (pattern);
+  if (py_pattern == NULL)
+    goto done;
+
+  py_other = raster_source_pattern_borrow ((cairo_pattern_t *)other);
+  if (py_other == NULL)
+    goto done;
+
+  result = PyObject_CallFunctionObjArgs (priv->copy.callback,
+                                         py_pattern, py_other, NULL);
+  if (result == NULL)
+    goto done;
+
+  status = PYCAIRO_PyLong_AsLong (result);
+
+done:
+  Py_XDECREF (result);
+  raster_source_pattern_unborrow (py_pattern);
+  raster_source_pattern_unborrow (py_other);
+  PyGILState_Release (gstate);
+  return status;
+}
+
+static void
+raster_source_pattern_set_callback (PycairoRasterSourceCallback *callback,
+                                    PyObject *value)
+{
+  Py_XINCREF (value);
+  Py_XDECREF (callback->callback);
+  callback->callback = value;
+}
+
+static PyObject *
+raster_source_pattern_set_acquire (PycairoRasterSourcePattern *obj,
+                                   PyObject *args)
+{
+  PycairoRasterSource *priv;
+  PyObject *acquire, *release;
+
+  if (!PyArg_ParseTuple (args, "OO:RasterSourcePattern.set_acquire",
+                         &acquire, &release))
+    return NULL;
+
+  if (!PyCallable_Check (acquire) || !PyCallable_Check (release)) {
+    PyErr_SetString (PyExc_TypeError, "expected callable");
+    return NULL;
+  }
+
+  priv = raster_source_pattern_get_data (obj);
+  if (priv == NULL)
+    return NULL;
+
+  raster_source_pattern_set_callback (&priv->acquire, acquire);
+  raster_source_pattern_set_callback (&priv->release, release);
+
+  cairo_raster_source_pattern_set_acquire (
+      obj->pattern, raster_source_pattern_acquire,
+      raster_source_pattern_release);
+
+  Py_RETURN_NONE;
+}
+
+static PyObject *
+raster_source_pattern_get_acquire (PycairoRasterSourcePattern *obj)
+{
+  PycairoRasterSource *priv = raster_source_pattern_get_data (obj);
+
+  if (priv == NULL)
+    return NULL;
+
+  return Py_BuildValue ("(OO)",
+                        priv->acquire.callback ? priv->acquire.callback
+                                               : Py_None,
+                        priv->release.callback ? priv->release.callback
+                                               : Py_None);
+}
+
+static PyObject *
+raster_source_pattern_set_snapshot (PycairoRasterSourcePattern *obj,
+                                    PyObject *args)
+{
+  PycairoRasterSource *priv;
+  PyObject *snapshot;
+
+  if (!PyArg_ParseTuple (args, "O:RasterSourcePattern.set_snapshot",
+                         &snapshot))
+    return NULL;
+
+  if (!PyCallable_Check (snapshot)) {
+    PyErr_SetString (PyExc_TypeError, "expected callable");
+    return NULL;
+  }
+
+  priv = raster_source_pattern_get_data (obj);
+  if (priv == NULL)
+    return NULL;
+
+  raster_source_pattern_set_callback (&priv->snapshot, snapshot);
+  cairo_raster_source_pattern_set_snapshot (
+      obj->pattern, raster_source_pattern_snapshot);
+
+  Py_RETURN_NONE;
+}
+
+static PyObject *
+raster_source_pattern_get_snapshot (PycairoRasterSourcePattern *obj)
+{
+  PycairoRasterSource *priv = raster_source_pattern_get_data (obj);
+
+  if (priv == NULL)
+    return NULL;
+
+  if (priv->snapshot.callback == NULL) {
+    Py_INCREF (Py_None);
+    return Py_None;
+  }
+
+  Py_INCREF (priv->snapshot.callback);
+  return priv->snapshot.callback;
+}
+
+static PyObject *
+raster_source_pattern_set_copy (PycairoRasterSourcePattern *obj,
+                                PyObject *args)
+{
+  PycairoRasterSource *priv;
+  PyObject *copy;
+
+  if (!PyArg_ParseTuple (args, "O:RasterSourcePattern.set_copy", &copy))
+    return NULL;
+
+  if (!PyCallable_Check (copy)) {
+    PyErr_SetString (PyExc_TypeError, "expected callable");
+    return NULL;
+  }
+
+  priv = raster_source_pattern_get_data (obj);
+  if (priv == NULL)
+    return NULL;
+
+  raster_source_pattern_set_callback (&priv->copy, copy);
+  cairo_raster_source_pattern_set_copy (obj->pattern,
+                                        raster_source_pattern_copy);
+
+  Py_RETURN_NONE;
+}
+
+static PyObject *
+raster_source_pattern_get_copy (PycairoRasterSourcePattern *obj)
+{
+  PycairoRasterSource *priv = raster_source_pattern_get_data (obj);
+
+  if (priv == NULL)
