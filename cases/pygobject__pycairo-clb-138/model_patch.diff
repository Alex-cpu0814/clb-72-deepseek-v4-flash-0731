+
+static PyObject *
+raster_source_pattern_set_finish (PycairoRasterSourcePattern *obj,
+                                  PyObject *args)
+{
+  PycairoRasterSource *priv;
+  PyObject *finish;
+
+  if (!PyArg_ParseTuple (args, "O:RasterSourcePattern.set_finish", &finish))
+    return NULL;
+
+  if (!PyCallable_Check (finish)) {
+    PyErr_SetString (PyExc_TypeError, "expected callable");
+    return NULL;
+  }
+
+  priv = raster_source_pattern_get_data (obj);
+  if (priv == NULL)
+    return NULL;
+
+  raster_source_pattern_set_callback (&priv->finish, finish);
+
+  Py_RETURN_NONE;
+}
+
+static PyObject *
+raster_source_pattern_get_finish (PycairoRasterSourcePattern *obj)
+{
+  PycairoRasterSource *priv = raster_source_pattern_get_data (obj);
+
+  if (priv == NULL)
+    return NULL;
+
+  if (priv->finish.callback == NULL) {
+    Py_INCREF (Py_None);
+    return Py_None;
+  }
+
+  Py_INCREF (priv->finish.callback);
+  return priv->finish.callback;
+}
+
+static PyObject *
+raster_source_pattern_new (PyTypeObject *type, PyObject *args,
+                           PyObject *kwds)
+{
+  PycairoPattern *o;
+  PycairoRasterSource *priv;
+  int content, width, height;
+
+  if (!PyArg_ParseTuple (args, "iii:RasterSourcePattern.__new__",
+                         &content, &width, &height))
+    return NULL;
+
+  priv = PyMem_Malloc (sizeof (PycairoRasterSource));
+  if (priv == NULL)
+    return PyErr_NoMemory ();
+
+  priv->acquire.callback = NULL;
+  priv->release.callback = NULL;
+  priv->snapshot.callback = NULL;
+  priv->copy.callback = NULL;
+  priv->finish.callback = NULL;
+  priv->content = content;
+  priv->pattern = NULL;
+
+  o = (PycairoPattern *)type->tp_alloc (type, 0);
+  if (o == NULL) {
+    PyMem_Free (priv);
+    return NULL;
+  }
+
+  o->pattern = cairo_pattern_create_raster_source (
+      priv, content, width, height);
+  if (o->pattern == NULL) {
+    PyMem_Free (priv);
+    Py_DECREF (o);
+    Pycairo_Check_Status (CAIRO_STATUS_NO_MEMORY);
+    return NULL;
+  }
+  priv->pattern = o->pattern;
+
+  if (Pycairo_Check_Status (cairo_pattern_status (o->pattern))) {
+    cairo_pattern_destroy (o->pattern);
+    o->pattern = NULL;
+    PyMem_Free (priv);
+    Py_DECREF (o);
+    return NULL;
+  }
+
+  if (cairo_pattern_set_user_data (
+        o->pattern, &PycairoRasterSourcePattern_key, priv,
+        (cairo_destroy_func_t)raster_source_pattern_destroy_func)) {
+    cairo_pattern_destroy (o->pattern);
+    o->pattern = NULL;
+    PyMem_Free (priv);
+    Py_DECREF (o);
+    Pycairo_Check_Status (CAIRO_STATUS_NO_MEMORY);
+    return NULL;
+  }
+
+  return (PyObject *)o;
+}
