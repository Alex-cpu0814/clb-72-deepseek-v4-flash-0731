+static Uint32
+_surface_read_pixel (SDL_Surface *surf, Uint8 *pixels, int x, int y)
+{
+    Uint8 *pixel = pixels + y * surf->pitch + x * surf->format->BytesPerPixel;
+    Uint32 color = 0;
+
+    switch (surf->format->BytesPerPixel) {
+    case 1:
+        color = *pixel;
+        break;
+    case 2:
+        color = *((Uint16 *) pixel);
+        break;
+    case 3:
+#if SDL_BYTEORDER == SDL_LIL_ENDIAN
+        color = (pixel[0]) + (pixel[1] << 8) + (pixel[2] << 16);
+#else
+        color = (pixel[2]) + (pixel[1] << 8) + (pixel[0] << 16);
+#endif
+        break;
+    case 4:
+        color = *((Uint32 *) pixel);
+        break;
+    default:
+        break;
+    }
+    return color;
+}
